# Copy to `.env` and fill in one provider block:  cp env.example .env
# `.env` is gitignored. You pay the provider directly.

# Provider: anthropic | openai
AOE2COACH_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
# AOE2COACH_MODEL=claude-opus-4-8            # full report model
# AOE2COACH_DETECT_MODEL=claude-haiku-4-5    # habit-detection model
# AOE2COACH_EFFORT=high                      # low | medium | high | xhigh | max

# OpenAI
# AOE2COACH_PROVIDER=openai
# OPENAI_API_KEY=
# AOE2COACH_MODEL=gpt-5.5                   # full report model
# AOE2COACH_DETECT_MODEL=gpt-5.4-mini       # habit-detection model
# AOE2COACH_EFFORT=high                     # none | low | medium | high | xhigh

# OpenAI-compatible endpoint (OpenRouter, Ollama, LM Studio, etc.)
# AOE2COACH_PROVIDER=openai
# OPENAI_API_KEY=dummy                      # use any placeholder for local servers if needed
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# AOE2COACH_MODEL=<model served by endpoint>
# AOE2COACH_DETECT_MODEL=<optional cheaper model served by endpoint>

# Optional limit
# AOE2COACH_MAX_TOKENS=8000
