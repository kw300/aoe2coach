# Copy to `.env` and fill in one provider block:  cp env.example .env
# `.env` is gitignored. You pay the provider directly.

# Provider: anthropic | openai. If omitted, an Anthropic key selects Anthropic;
# otherwise an OpenAI key selects OpenAI. With neither key, defaults to Anthropic.
# AOE2COACH_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
# AOE2COACH_MODEL=claude-opus-4-8            # full report model
# AOE2COACH_DETECT_MODEL=claude-haiku-4-5    # habit-detection model
# AOE2COACH_EFFORT=high                     # low | medium | high | xhigh | max

# OpenAI
# AOE2COACH_PROVIDER=openai
# OPENAI_API_KEY=
# AOE2COACH_MODEL=gpt-5.5                   # full report model
# AOE2COACH_DETECT_MODEL=gpt-5.4-mini       # habit-detection model
# AOE2COACH_EFFORT=high                     # none | low | medium | high | xhigh

# OpenAI-compatible endpoint (OpenRouter, Ollama, LM Studio, etc.)
# AOE2COACH_PROVIDER=openai
# OPENAI_API_KEY=dummy                     # use a placeholder for local servers if needed
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# AOE2COACH_MODEL=<model served by endpoint>
# AOE2COACH_DETECT_MODEL=<optional cheaper model served by endpoint>

# Choose models by coaching task. Analysis, chat, and trends inherit the default
# connection unless overridden. Detection uses the provider's cheap model by default;
# on custom endpoints it reuses your default model unless DETECT_MODEL is specified.
# analysis = replay reports and the opening chat report
# chat     = follow-up conversation after the opening report
# trends   = standalone multi-game trend reports
# detect   = lightweight habit detection
# Use any model ID supported by the selected provider/endpoint.
# AOE2COACH_ANALYSIS_MODEL=your-analysis-model
# AOE2COACH_CHAT_MODEL=your-chat-model
# AOE2COACH_TRENDS_MODEL=your-trends-model
# AOE2COACH_DETECT_MODEL=your-detection-model

# Models without adaptive thinking: omit Anthropic thinking and effort parameters.
# Haiku and the default habit-detection pass omit those parameters automatically.
# AOE2COACH_THINKING=off              # adaptive (default) | off; Anthropic only
# AOE2COACH_CHAT_THINKING=off
# AOE2COACH_MAX_TOKENS=8000           # positive output limit; Anthropic only
# AOE2COACH_CHAT_MAX_TOKENS=2000
# AOE2COACH_CHAT_EFFORT=low           # provider-specific accepted values above
# Habit detection defaults to at most 1200 tokens and no reasoning effort.
# AOE2COACH_DETECT_MAX_TOKENS=1800
# AOE2COACH_DETECT_EFFORT=low
# Hosted OpenAI receives reasoning_effort; custom endpoints omit it.

# A task can also use a different provider, endpoint, or key environment variable:
# AOE2COACH_CHAT_PROVIDER=openai
# AOE2COACH_CHAT_MODEL=your-endpoint-model
# AOE2COACH_CHAT_BASE_URL=http://localhost:1234/v1
# AOE2COACH_CHAT_API_KEY_ENV=MY_CHAT_API_KEY
# MY_CHAT_API_KEY=...                # set the actual key in .env or your environment
# API_KEY_ENV names the variable; never put a key directly in that setting.
# Changing provider uses its model, effort, endpoint, and key-variable defaults.
# Custom OpenAI endpoints require an explicit model ID.

# The same options work with ANALYSIS, CHAT, TRENDS, or DETECT. Blank overrides inherit,
# except detection's model, effort, and token limit keep the cheap defaults above.
# Optional default connection overrides (inherited by same-provider tasks):
# AOE2COACH_BASE_URL=https://your-proxy.example/v1
# AOE2COACH_API_KEY_ENV=MY_DEFAULT_API_KEY
# OPENAI_BASE_URL and ANTHROPIC_BASE_URL also work as provider endpoint defaults.
# Keep endpoint URLs free of embedded credentials, query parameters, or fragments.
# Run `aoe2coach doctor` to inspect all resolved task models without making API calls.
