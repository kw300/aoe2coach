# Copy this file to `.env` and fill in your key:  cp env.example .env
# `.env` is gitignored — never commit it. aoe2coach is bring-your-own-model:
# you pay the model provider directly.

# ── Default: Anthropic (best results on Claude Opus 4.7) ─────────────────────
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides:
# AOE2COACH_MODEL=claude-opus-4-7      # e.g. claude-sonnet-4-6 for lower cost
# AOE2COACH_EFFORT=high                # low | medium | high | max (Anthropic only)

# ── Or: any OpenAI-compatible API (GPT, OpenRouter, local Ollama/LM Studio) ──
# Uncomment these to use a non-Anthropic model:
# AOE2COACH_PROVIDER=openai
# AOE2COACH_MODEL=gpt-5.1              # the model id your endpoint serves
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1   # omit for OpenAI; or http://localhost:11434/v1 for Ollama
#   (OpenRouter lets AOE2COACH_MODEL be e.g. "anthropic/claude-opus-4-7" or "google/gemini-..." )
