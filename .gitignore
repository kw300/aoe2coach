# --- Secrets: never commit ---
.env
.env.*
!.env.example

# --- Replays: contain player names + Steam IDs (PII). Don't commit real ones. ---
# A single tiny, anonymized fixture lives under tests/fixtures/ and is committed
# explicitly there; everything else is ignored.
*.aoe2record
*.aoe2mpgame
*.mgz
*.mgx
*.mgl
!tests/fixtures/*.aoe2record

# --- Generated coaching reports (keep the committed examples) ---
reports/*
!reports/session-exports/
reports/session-exports/*
!reports/session-exports/aoc-mgz-de-66.6-2026-06-02-10-13-30.md
*.coach.md
*.minimap.png

# --- Local media exports ---
docs/assets/*.mp4
docs/assets/caption-review/
docs/assets/*caption-table.md
docs/assets/*caption-review.jpg

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.venv*/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Editors / OS ---
.DS_Store
.idea/
.vscode/
